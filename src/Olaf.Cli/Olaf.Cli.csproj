<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Olaf.Core\Olaf.Core.csproj" />
    <ProjectReference Include="..\Olaf.Parsers\Olaf.Parsers.csproj" />
    <ProjectReference Include="..\Olaf.Resolvers\Olaf.Resolvers.csproj" />
    <ProjectReference Include="..\Olaf.Formatters\Olaf.Formatters.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>olaf</ToolCommandName>
    <PackageId>olaf</PackageId>
    <Version>0.1.0-preview.3</Version>
    <Description>License scanner: scans npm, nuget, and pip projects, resolves licenses, and writes a report.</Description>
    <Authors>olaf contributors</Authors>
    <!-- No LICENSE file in repo; using MIT expression. Add LICENSE and keep in sync if license changes. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishRID)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>$(PublishRID)</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
